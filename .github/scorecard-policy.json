{
  "version": 3,
  "defaultMinimumScore": 10,
  "failOnUnconfiguredResults": true,
  "profiles": {
    "pull-request": [
      "BinaryArtifactsID",
      "DependencyUpdateToolID",
      "LicenseID",
      "PinnedDependenciesID",
      "SecurityPolicyID",
      "TokenPermissionsID",
      "DangerousWorkflowID",
      "VulnerabilitiesID",
      "SASTID",
      "FuzzingID"
    ],
    "repository": [
      "BranchProtectionID",
      "BinaryArtifactsID",
      "DependencyUpdateToolID",
      "LicenseID",
      "PinnedDependenciesID",
      "SecurityPolicyID",
      "TokenPermissionsID",
      "DangerousWorkflowID",
      "VulnerabilitiesID",
      "SASTID",
      "FuzzingID",
      "MaintainedID",
      "CodeReviewID",
      "CIIBestPracticesID",
      "CITestsID",
      "PackagingID",
      "SignedReleasesID",
      "ContributorsID"
    ]
  },
  "checks": {
    "BranchProtectionID": {
      "name": "Branch-Protection",
      "minimumScore": 8
    },
    "BinaryArtifactsID": {
      "name": "Binary-Artifacts",
      "minimumScore": 10
    },
    "DependencyUpdateToolID": {
      "name": "Dependency-Update-Tool",
      "minimumScore": 10
    },
    "LicenseID": {
      "name": "License",
      "minimumScore": 9
    },
    "PinnedDependenciesID": {
      "name": "Pinned-Dependencies",
      "minimumScore": 10
    },
    "SecurityPolicyID": {
      "name": "Security-Policy",
      "minimumScore": 7
    },
    "TokenPermissionsID": {
      "name": "Token-Permissions",
      "minimumScore": 10
    },
    "DangerousWorkflowID": {
      "name": "Dangerous-Workflow",
      "minimumScore": 10
    },
    "VulnerabilitiesID": {
      "name": "Vulnerabilities",
      "minimumScore": 10
    },
    "SASTID": {
      "name": "SAST",
      "minimumScore": 10
    },
    "FuzzingID": {
      "name": "Fuzzing",
      "minimumScore": 10
    },
    "MaintainedID": {
      "name": "Maintained",
      "minimumScore": 10,
      "waiver": {
        "expires": "2026-11-10",
        "reason": "OpenSSF Scorecard intentionally scores repositories created within the previous 90 days as zero. This repository reaches 90 days on 2026-11-09."
      }
    },
    "CodeReviewID": {
      "name": "Code-Review",
      "minimumScore": 6,
      "waiver": {
        "expires": "2026-10-15",
        "reason": "The repository is new and needs enough reviewed change history for Scorecard to observe the enforced human-review process. Tracked in issue 3."
      }
    },
    "CIIBestPracticesID": {
      "name": "CII-Best-Practices",
      "minimumScore": 2,
      "waiver": {
        "expires": "2026-09-30",
        "reason": "The OpenSSF Best Practices registration is complete, but the project entry and README badge still require a reviewed follow-up change. Tracked in issue 4."
      }
    },
    "CITestsID": {
      "name": "CI-Tests",
      "minimumScore": 10
    },
    "PackagingID": {
      "name": "Packaging",
      "minimumScore": 0,
      "waiver": {
        "expires": "2026-12-31",
        "reason": "The project has not published its first official VSIX release. The release workflow and verification evidence are implemented and will be exercised for v0.1.0."
      }
    },
    "SignedReleasesID": {
      "name": "Signed-Releases",
      "minimumScore": 0,
      "waiver": {
        "expires": "2026-12-31",
        "reason": "No official release exists yet. The release workflow is configured to publish provenance and SBOM attestations with the first v0.1.0 release."
      }
    },
    "ContributorsID": {
      "name": "Contributors",
      "minimumScore": 0
    }
  }
}
